# This file is installed as /etc/nycu-uav-offboard/config.env.
# The installer writes shell-escaped absolute paths for the selected RPi user.

NYCU_SERVICE_USER=pi
NYCU_USER_HOME=/home/pi
NYCU_ROS_WS=/home/pi/NYCU_ROS_WS
ROS_SETUP=/opt/ros/jazzy/setup.bash
ROS_DOMAIN_ID=0

PIXHAWK_SERIAL=/dev/serial/by-id/REPLACE_WITH_PIXHAWK_UART_ADAPTER
PIXHAWK_BAUD=921600

LR24_SERIAL=/dev/serial/by-id/REPLACE_WITH_AIRBORNE_LR24
LR24_BAUD=115200

DDS_AGENT_BINARY=/usr/local/bin/MicroXRCEAgent

# 0 waits indefinitely for USB serial devices during boot. A positive value
# makes the wrapper fail after that many seconds; systemd then retries it.
DEVICE_WAIT_TIMEOUT_SECONDS=0

